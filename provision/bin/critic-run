#!/usr/bin/env bash
# クリティックのエージェントを、1つのブリーフに対して非対話で起動する。
#
#     sudo -u critic /srv/swa/bin/critic-run <brief-file> [seconds]
#
# 形も理由も planner-run、solver-run と同じ。ランナーは sudo を持たず、
# /etc/sudoers.d/93-runner-to-critic はこのスクリプトだけを名指しし、Runas (critic)
# に限る。横への移動で、昇格ではない。
#
# このアカウントの価値は届かないものにあり、そのどれもここでは強制しない:
#
#   plan/          0700 runner  -- 判定する計画を読めない
#   tests/         グループに無い -- 通ったテストを読めない
#   planner/out    plannerw     -- 書かれている最中の提案を見られない
#   brief/         solverw      -- ソルバーに伝えた内容を見られない
#
# 4つとも、このファイルより前に実測した。計画を読むクリティックは「受け入れ
# 条件はすべて満たされている」と報告する。真だが無価値だ。テストを読む
# クリティックはテストが通ると報告する。この役の価値はすべて無知にある。だから
# 無知を、後のブリーフが緩めうるプロンプトの1行ではなく、ファイルシステムの
# 事実にする。
set -euo pipefail

BRIEF="${1:?usage: critic-run <brief-file> [seconds]}"
LIMIT="${2:-900}"
[ -r "$BRIEF" ] || { echo "critic-run: cannot read brief: $BRIEF" >&2; exit 2; }

OUT=/srv/swa/critic/out

# 資格情報、モデルと effort、使い捨ての HOME。中身は agent-common.sh。
# 使い捨ての HOME には、ここでは2つ目の意味もある。同じ計画への2つの批評が、
# 覚えていることで互いに合わせられてはならない。どれもブリーフだけから始める。
. /srv/swa/bin/agent-common.sh
agent_setup critic-run critic

cd "$OUT"

# planner-run と同じく、既定のシステムプロンプトを、ブリーフが唯一の入力である
# ことと作業ディレクトリの場所だけに置き換える。
SYSTEM_PROMPT="You are the critic in an automated build loop. The user message is your brief and your only input. Your working directory is $OUT; a relative path in the brief is relative to it. Use the Read and Write tools with absolute paths. Write only the files the brief asks for. No one will answer questions, so do not ask any. When done, reply as the brief says."

# --safe-mode/ --setting-sources "" / --no-session-persistence
#     プランナーと同じく、ブリーフだけを入力にする（RUNNER_SPEC 5 章）。
# --output-format json
#     結果の文と消費量を1つの JSON で返す。ランナーが消費量を台帳に残し、
#     結果の文だけを取り出す。
# --allowedTools "Read Write"
#     標準入力でブリーフを読み、ここに指摘のファイルを1つ書く。Edit は許さない。
#     ここに書き直すべきものは無い。
# --tools "Read,Write"
#     使えるツールそのものを同じ2つに絞り、ほかのツールの定義を文脈から外す。
# --system-prompt
#     既定のシステムプロンプトを上の短いものに置き換える。
set +e
timeout --kill-after=30 "$LIMIT" claude -p \
  "${role_args[@]}" \
  --output-format json \
  --safe-mode \
  --setting-sources "" \
  --no-session-persistence \
  --allowedTools "Read Write" \
  --tools "Read,Write" \
  --system-prompt "$SYSTEM_PROMPT" \
  < "$BRIEF"
rc=$?
set -e
exit "$rc"
